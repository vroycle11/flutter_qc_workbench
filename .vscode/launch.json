{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run QA Workbench Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/integrations/vscode",
        "${workspaceFolder}/example"
      ],
      "outFiles": [
        "${workspaceFolder}/integrations/vscode/out/**/*.js"
      ]
    }
  ]
}
